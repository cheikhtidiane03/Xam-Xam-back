# Copier ce fichier en .env (ou exporter ces variables dans ton shell)
# avant de lancer l'application.

# En local (docker-compose), DB_URL est utilise directement.
# Sur Render, DB_HOST/DB_PORT/DB_NAME/DB_USERNAME/DB_PASSWORD sont injectes
# automatiquement depuis la base managee (voir render.yaml) et composent
# l'URL JDBC automatiquement - pas besoin de DB_URL dans ce cas.
DB_URL=jdbc:postgresql://localhost:5432/xaamxaam
DB_USERNAME=xaamxaam
DB_PASSWORD=xaamxaam

# Genere une valeur aleatoire forte (>= 256 bits) pour la production.
# Exemple : openssl rand -base64 32
JWT_SECRET=changeMeInProdWithAStrongRandomSecretOfAtLeast256Bits
JWT_EXPIRATION_MS=86400000

# Cle API Anthropic (obligatoire pour que SocratiqueService fonctionne)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Quota de requetes IA par eleve et par jour (gestion du cout)
QUOTA_REQUETES_JOUR=30

# Cle API du service OCR (OCR.space). La cle "helloworld" par defaut est une
# cle de demo publique tres limitee (usage test uniquement) : cree ton propre
# compte gratuit sur https://ocr.space/ocrapi/freekey pour un usage reel.
OCR_API_KEY=helloworld
OCR_API_URL=https://api.ocr.space/parse/image
OCR_LANGUE=fre

# CORS : liste d'origines separees par des virgules autorisees a appeler l'API.
# Ne JAMAIS remettre "*" en production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SMTP pour l'envoi d'emails (verification de compte, mot de passe oublie,
# rapports hebdomadaires parent). Sans ces variables, EmailService logue
# l'erreur et continue sans bloquer l'action metier.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_EXPEDITEUR=no-reply@xaamxaam.sn
FRONTEND_URL=http://localhost:3000

# Protection brute-force sur /api/auth/login
MAX_TENTATIVES_CONNEXION=5
FENETRE_BLOCAGE_MINUTES=15
